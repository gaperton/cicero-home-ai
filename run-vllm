#!/usr/bin/env bash
set -euo pipefail

reexec_with_login_group_if_needed() {
  local expected_gid current_gid group_name argv_q
  expected_gid="$(getent passwd "${USER:-$(id -un)}" | cut -d: -f4)"
  current_gid="$(id -g)"
  if [ -n "$expected_gid" ] && [ "$current_gid" != "$expected_gid" ] && [ "${VLLM_LOGIN_GROUP_FIXED:-0}" != "1" ]; then
    group_name="$(getent group "$expected_gid" | cut -d: -f1)"
    printf -v argv_q '%q ' "$0" "$@"
    echo "Switching primary group to '$group_name' for rootless Podman..."
    exec sg "$group_name" -c "VLLM_LOGIN_GROUP_FIXED=1 $argv_q"
  fi
}
reexec_with_login_group_if_needed "$@"

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
VLLM_DIR="$SCRIPT_DIR/vllm-rocm"
BOX_NAME="${VLLM_BOX_NAME:-vllm-r9700}"

if [ ! -d "$VLLM_DIR" ]; then
  echo "ERROR: expected upstream vLLM toolbox repo at: $VLLM_DIR" >&2
  exit 1
fi

if ! command -v distrobox >/dev/null 2>&1; then
  echo "ERROR: distrobox is not installed. Run ./install-vllm first." >&2
  exit 1
fi

if ! distrobox list 2>/dev/null | awk '{print $3}' | grep -qx "$BOX_NAME"; then
  echo "ERROR: Podman-backed Distrobox '$BOX_NAME' does not exist. Run ./install-vllm first." >&2
  exit 1
fi

cd "$VLLM_DIR"
exec distrobox enter "$BOX_NAME" -- bash -lc 'set -euo pipefail; export LD_LIBRARY_PATH="/opt/venv/lib64/python3.12/site-packages/_rocm_sdk_core/lib:/opt/venv/lib64/python3.12/site-packages/_rocm_sdk_libraries_gfx120X_all/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"; rocm-smi; cd ./vllm-rocm 2>/dev/null || cd ~/data/cicero-home-ai/vllm-rocm 2>/dev/null || true; exec start-vllm'
