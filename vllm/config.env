# vllm/config.env — all settings of the vLLM stack. Read by the scripts here and
# passed to docker compose. Paths are relative to the repo root.

# vllm-radiance: vLLM with gfx1201 kernels (R4D attention, GDN, P2P TP=2
# all-reduce). Pinned: its torch/Triton/vLLM versions form a set, and unqualified
# bumps cause TP hangs. Change it with ./vllm/update.sh.
IMAGE=magiccodingman/vllm-radiance:1.0.387

MODEL_REPO=Qwen/Qwen3.8-27B-FP8
MODEL_DIR=models/Qwen3.8-27B-FP8
# The model id Hindsight, Hermes, mem0 and Open WebUI request.
SERVED_MODEL_NAME=qwen3.8-27b
PORT=8080

# llama.cpp sidecar for ASR and the reranker, started before vLLM. Empty
# LLAMA_PRESET runs vLLM alone; then re-size the KV pool below.
LLAMA_PRESET=vllm/sidecar.ini
LLAMA_PORT=8081

# With KV_CACHE_MEMORY_BYTES set, only vLLM's startup check: free VRAM, after
# the sidecar has loaded, must cover GPU_UTIL x 31.86 GiB.
GPU_UTIL=0.85
# KV pool per card (10.75 GiB = 606K tokens). Set explicitly because vLLM's own
# sizing reserves ~4 GiB per card for an activation peak that never occurs.
# Sized to leave ~1.2-1.5 GiB free on each card with the sidecar loaded.
# Re-size (README, "KV pool sizing") after changing the image, driver, SPEC,
# MTP_TOKENS, MAX_NUM_SEQS or sidecar.ini.
KV_CACHE_MEMORY_BYTES=11542724608
# Per-request limit (prompt + output), not a reservation: all requests share
# the pool above. 262144 is the model's native limit.
MAX_MODEL_LEN=262144
# Maximum concurrent requests; each also holds a fixed-size GDN recurrent state.
# 16 gives the best throughput at the usual 2-4 concurrent requests.
MAX_NUM_SEQS=16

# mtp = speculative decoding with Qwen's built-in MTP head; the fork's
#       controller picks each request's draft depth per step, up to MTP_TOKENS.
# off = no speculative decoding.
SPEC=mtp
# Maximum draft depth. Deeper drafts are mostly rejected on prose and code but
# still cost verification; 3 is fastest under mixed load.
MTP_TOKENS=3

# Calibrated per-layer FP8 KV scales, bound to this exact checkpoint: re-run
# ./vllm/calibrate-kv.sh after changing MODEL_REPO. Empty = default scales.
FP8_KV_SCALES=vllm/calibration/qwen3.8-27b-fp8-kv-enru-20260926.safetensors
