# vllm/config.env — the only file to edit. Read by run.sh, install.sh and
# update.sh, and passed to docker compose. Paths are relative to the repo root.

# vllm-radiance: vLLM 0.30 + hand-written gfx1201 kernels (R4D attention, GDN,
# and the P2P TP=2 all-reduce that upstream vLLM only enables on MI300/MI350).
# Pinned on purpose: the image is a compiler stack (torch/triton/vLLM) and the
# fork warns that unqualified bumps cause TP hangs. Change it with ./vllm/update.sh.
IMAGE=magiccodingman/vllm-radiance:1.0.387

MODEL_REPO=Qwen/Qwen3.8-27B-FP8
MODEL_DIR=models/Qwen3.8-27B-FP8
# Same id the llama.cpp router used, so Hindsight, Hermes, mem0 and Open WebUI
# keep working unchanged.
SERVED_MODEL_NAME=qwen3.8-27b
PORT=8080

# With KV_CACHE_MEMORY_BYTES set, this is only vLLM's startup check (free VRAM
# must cover GPU_UTIL x 31.86 GiB; ~31.3 GiB is free at boot). vLLM claims both
# cards symmetrically, so nothing else can share them.
GPU_UTIL=0.95
# KV pool per card, set explicitly: vLLM's own sizing reserves ~4 GiB/card for
# an activation peak that never materialises. 13.0 GiB -> 670,536 tokens
# (2.56 full 262K contexts), idle 30.52 of 31.86 GiB/card, and the same peak
# under a 4 x 187K-token stress test (1.34 GiB free). Re-validate with
# ./vllm/stress-context.py after changing the image, driver, SPEC or MAX_NUM_SEQS.
KV_CACHE_MEMORY_BYTES=13958643712
# Per-request ceiling (prompt + output), not a reservation: all requests draw on
# the shared pool above. 262144 is the model's native limit.
MAX_MODEL_LEN=262144
# Ceiling on simultaneously running requests (each also holds a fixed-size GDN
# recurrent state). 32 captures more CUDA graphs: measured -7% aggregate at 2
# requests, +5-6% at 8, neutral at 1 and 4, versus 8.
MAX_NUM_SEQS=32

# mtp = Qwen's built-in MTP head, fork's fast-draft profile (up to 8 draft tokens,
#       depth chosen per request). ~1.5x decode, but roughly halves the KV pool.
# off = no speculative decoding: the fork's tool-call-qualified default.
SPEC=mtp

# Calibrated per-layer FP8 KV scales (EN + RU + code corpus; see README
# "FP8 KV-cache calibration"). Bound to this exact checkpoint: re-run
# ./vllm/calibrate-kv.sh after changing MODEL_REPO. Empty = default scales.
FP8_KV_SCALES=vllm/calibration/qwen3.8-27b-fp8-kv-enru-20260926.safetensors
