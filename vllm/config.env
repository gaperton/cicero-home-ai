# vllm/config.env — the only file to edit. Read by run.sh, install.sh and
# update.sh, and passed to docker compose. Paths are relative to the repo root.

# vllm-radiance: vLLM 0.30 + hand-written gfx1201 kernels (R4D attention, GDN,
# and the P2P TP=2 all-reduce that upstream vLLM only enables on MI300/MI350).
# Pinned on purpose: the image is a compiler stack (torch/triton/vLLM) and the
# fork warns that unqualified bumps cause TP hangs. Change it with ./vllm/update.sh.
IMAGE=magiccodingman/vllm-radiance:1.0.387

MODEL_REPO=Qwen/Qwen3.8-27B-FP8
MODEL_DIR=models/Qwen3.8-27B-FP8
# Same id the llama.cpp router used, so Hindsight, Hermes, mem0 and Open WebUI
# keep working unchanged.
SERVED_MODEL_NAME=qwen3.8-27b
PORT=8080

# llama.cpp sidecar (ASR + reranker) on its own port, loaded before vLLM; see
# sidecar.ini. Empty LLAMA_PRESET = vLLM alone, and then KV_CACHE_MEMORY_BYTES
# can go back to 14428405760 (13.44 GiB) and GPU_UTIL to 0.95.
LLAMA_PRESET=vllm/sidecar.ini
LLAMA_PORT=8081

# With KV_CACHE_MEMORY_BYTES set, this is only vLLM's startup check (free VRAM
# must cover GPU_UTIL x 31.86 GiB). ~31.3 GiB is free at boot, minus the
# sidecar's ~2.5 GiB on the fuller card = ~28.8 GiB, so 0.85 (27.1 GiB) passes.
GPU_UTIL=0.85
# KV pool per card, set explicitly: vLLM's own sizing reserves ~4 GiB/card for
# an activation peak that never materialises. Alone, 13.44 GiB -> 758,606 tokens
# left 1.32 GiB free per card (idle and under a 4 x 187K-token stress test).
# With the sidecar (~2.5 GiB on each card, see sidecar.ini) the pool drops to
# 10.75 GiB -> 606,299 tokens (2.31 full 262K contexts). Measured 2026-09-26:
# idle = peak under 4 x 187K tokens + 4 decode streams with ASR and rerank
# traffic on the sidecar, 0 preemptions, min free 1.51 GiB on ROCm0 / 1.20 GiB
# on ROCm1. Re-validate with
# ./vllm/stress-context.py after changing the image, driver, SPEC, MTP_TOKENS,
# MAX_NUM_SEQS (graph memory) or sidecar.ini.
KV_CACHE_MEMORY_BYTES=11542724608
# Per-request ceiling (prompt + output), not a reservation: all requests draw on
# the shared pool above. 262144 is the model's native limit.
MAX_MODEL_LEN=262144
# Ceiling on simultaneously running requests (each also holds a fixed-size GDN
# recurrent state). Measured with MTP ceiling 8: 16 beats 32 at 2-4 requests
# (+7% / +11% aggregate) and loses 4% at 8; 8 and 16 tie within noise.
MAX_NUM_SEQS=16

# mtp = Qwen's built-in MTP head, fork's fast-draft profile: the dynamic
#       controller picks each request's draft depth per step (confidence gate +
#       batch-size schedule), up to MTP_TOKENS.
# off = no speculative decoding: the fork's tool-call-qualified default.
SPEC=mtp
# Draft-depth ceiling. Measured at 16 seqs: 3 and 4 are tied and beat 8 by
# 11-13% at 1-4 requests and ~20% at 8 (deep drafts on prose/code are mostly
# rejected but still cost verification); 3 is best under mixed load and prefill.
MTP_TOKENS=3

# Calibrated per-layer FP8 KV scales (EN + RU + code corpus; see README
# "FP8 KV-cache calibration"). Bound to this exact checkpoint: re-run
# ./vllm/calibrate-kv.sh after changing MODEL_REPO. Empty = default scales.
FP8_KV_SCALES=vllm/calibration/qwen3.8-27b-fp8-kv-enru-20260926.safetensors
