# Template for mem0/upstream/server/.env (upstream: server/.env.example).
# install.sh creates the real file once, filling the @...@ secrets, and never
# overwrites it afterwards; it only refreshes MEM0AI_VERSION. After editing it:
#   cd mem0/upstream/server && docker compose up -d --force-recreate mem0

# The server's built-in defaults always use the "openai" provider for both the
# LLM and the embedder; the OpenAI SDK reads these two variables, so the defaults
# land on the shared llama.cpp router. mem0/configure.json then switches the
# embedder to local bge-m3 and turns Qwen's thinking off.
OPENAI_API_KEY=none
OPENAI_BASE_URL=http://127.0.0.1:8080/v1
MEM0_DEFAULT_LLM_MODEL=qwen3.8-27b
MEM0_DEFAULT_EMBEDDER_MODEL=BAAI/bge-m3

# Host PostgreSQL 18, the cluster Hindsight uses. Role mem0 owns database mem0
# (pgvector memories) and mem0_app (users, API keys, request log, config
# overrides); configure-postgresql.sh creates all three.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=mem0
POSTGRES_USER=mem0
POSTGRES_PASSWORD=@POSTGRES_PASSWORD@
POSTGRES_COLLECTION_NAME=memories
APP_DB_NAME=mem0_app

# Auth stays on (upstream default). install.sh creates the admin and an API key
# with upstream's scripts/seed.sh and stores them in ~/.config/mem0/admin.json.
ADMIN_API_KEY=
JWT_SECRET=@JWT_SECRET@
AUTH_DISABLED=false

# Upstream sends an onboarding event to PostHog unless this is false.
MEM0_TELEMETRY=false

# mem0ai version pinned by docker-compose.override.yaml; must match the
# checked-out tag. Maintained by install.sh.
MEM0AI_VERSION=@MEM0AI_VERSION@
