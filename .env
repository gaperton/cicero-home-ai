# .env — ROCm/HIP build flags and server flags.
export CMAKE_CXX_FLAGS_RELEASE="-O3 -DNDEBUG"
export CMAKE_C_FLAGS_RELEASE="-O3 -DNDEBUG"

# HIP toolchain. ggml's `enable_language(HIP)` must find ROCm's clang, not the
# system one; ROCM_PATH also seeds ggml-hip's CMAKE_PREFIX_PATH so find_package
# picks up hip/hipblas/rocblas.
export ROCM_PATH=/opt/rocm
export HIP_PATH=/opt/rocm
export HIPCXX=/opt/rocm/llvm/bin/clang++

# gfx1201 = Radeon AI PRO R9700 (RDNA4), the only arch on this box. Naming it
# explicitly keeps the ggml-cuda template instances from being compiled once per
# target — that set dominates the build.
#
# GGML_LTO is deliberately absent. ggml/src/CMakeLists.txt turns it into a
# directory-scoped CMAKE_INTERPROCEDURAL_OPTIMIZATION, so it would also cover the
# HIP target; untested here, and a very slow link on a multi-GB static blob.
# GGML_VULKAN=OFF is stated rather than omitted: a build dir left over from the
# Vulkan era keeps GGML_VULKAN:BOOL=ON in its CMakeCache, and simply dropping the
# flag would silently produce a dual-backend binary instead of a ROCm-only one.
CMAKE_FLAGS="-DGGML_HIP=ON -DGGML_VULKAN=OFF -DGPU_TARGETS=gfx1201 -DGGML_NATIVE=1 -DCMAKE_BUILD_TYPE=Release"

# Flags passed to each llama-server instance
SERVER_FLAGS="--host 0.0.0.0 --models-max 1"
