# cmake GPU backend flags — one variable per checkout
CMAKE_VULKAN_FLAGS="-DGGML_VULKAN=ON"
export HIPCXX="$(hipconfig -l)/clang"
export HIP_PATH="$(hipconfig -R)"
export CMAKE_CXX_FLAGS_RELEASE="-O3 -DNDEBUG"
export CMAKE_C_FLAGS_RELEASE="-O3 -DNDEBUG"
CMAKE_ROCM_FLAGS="-DGGML_HIP=ON -DGGML_RPC=1 -DGGML_NATIVE=1 -DGGML_HIP_RCCL=ON -DGGML_CUDA_NO_PEER_COPY=1 -DGGML_HIP_ROCWMMA_FATTN=ON -DCMAKE_C_COMPILER=$(hipconfig -l)/clang -DCMAKE_CXX_COMPILER=$(hipconfig -l)/clang++ -DCMAKE_BUILD_TYPE=Release -DGPU_TARGETS=gfx1200;gfx1201 -DAMDGPU_TARGETS=gfx1200;gfx1201"

# llama-server flags
SERVER_FLAGS_COMMON="--host 0.0.0.0 --models-max 1 --webui-mcp-proxy"
SERVER_FLAGS_VULKAN=""
SERVER_FLAGS_ROCM=""
