# rocm/.env — ROCm build flags and server flags
export HIPCXX="$(hipconfig -l)/clang"
export HIP_PATH="$(hipconfig -R)"
export CMAKE_CXX_FLAGS_RELEASE="-O3 -DNDEBUG"
export CMAKE_C_FLAGS_RELEASE="-O3 -DNDEBUG"
CMAKE_FLAGS="-DGGML_HIP=ON -DGGML_RPC=1 -DGGML_NATIVE=1 -DGGML_HIP_RCCL=ON -DGGML_CUDA_NO_PEER_COPY=OFF -DCMAKE_C_COMPILER=$(hipconfig -l)/clang -DCMAKE_CXX_COMPILER=$(hipconfig -l)/clang++ -DCMAKE_BUILD_TYPE=Release -DGPU_TARGETS=gfx1201"

# Extra llama-server flags for this backend (on top of SERVER_FLAGS_COMMON)
SERVER_FLAGS_EXTRA=""
