# rad/profiles/flashnext.env — Qwen3.8-Flash-Next (MoE, 114 GiB); experts that do not fit VRAM
# stream from pinned RAM. Sourced by run.sh after config.env.

RADIANCE_MODEL=qwen3.8-next-flash-fp8-iq4r-moe.rad
# Downloaded when missing. Files are replaced under the same name, so the revision is pinned.
RADIANCE_MODEL_REPO=StillDeadcode/qwen3.8-next-flash-fp8-iq4r-moe
RADIANCE_MODEL_REVISION=8267a67384583f6be309981baf878b09ff900a9a

# Pinned host tier for experts, per card.
HOST_POOL_MIB=12288

# Engine flags beyond compose.yaml's, from upstream deploy/compose/flashnext.yaml.
RADIANCE_ARGS="--tp-wire wht6 --placement expert_tiered --host-pool-mib $HOST_POOL_MIB --num-speculative-tokens 3 --max-num-batched-tokens 2048"
