# rad/profiles/flashnext-uncensored.env — Qwen3.8-Flash-Next with refusals abliterated (MoE,
# 113.6 GiB), same recipe and flags as flashnext. Sourced by run.sh after config.env.

RADIANCE_MODEL=qwen3.8-next-flash-uncensored-fp8-iq4r-moe.rad
# Downloaded when missing. Files are replaced under the same name, so the revision is pinned.
RADIANCE_MODEL_REPO=StillDeadcode/qwen3.8-next-flash-uncensored-fp8-iq4r-moe
RADIANCE_MODEL_REVISION=9a245e2952eb0d54313bb0eb373fb5c559be00d6

# Pinned host tier for experts, per card.
HOST_POOL_MIB=12288

# Engine flags beyond compose.yaml's; the model card gives the same serve line as flashnext.
RADIANCE_ARGS="--tp-wire wht6 --placement expert_tiered --host-pool-mib $HOST_POOL_MIB --num-speculative-tokens 3 --max-num-batched-tokens 2048"
