# rad/config.env — settings of the radiance stack shared by every model. Read by run.sh and
# passed to docker compose. Paths are relative to the repo root.

# Pinned: releases land several times a day.
RADIANCE_IMAGE=stilldeadcode/radiance:2.0.0

# Active model: rad/profiles/<name>.env (file, repo) and <name>.yaml (engine keys). Change with ./switch.sh.
RADIANCE_PROFILE=flashnext

# One id for every profile, so clients need no change on a switch; logs/rad.log dates each start.
# Requests must name it or one of the profile's aliases.
SERVED_MODEL_NAME=qwen-local

# radiance 2.0 containers; models/rad holds the FP8 ones 2.0 refuses.
RADIANCE_MODELS=models/radiance_v2

# radiance bind address; "::" is dual-stack (IPv4 arrives as ::ffff:a.b.c.d).
HOST=::
PORT=8080
