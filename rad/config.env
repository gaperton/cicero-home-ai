# rad/config.env — settings of the radiance stack shared by every model. Read by run.sh and
# passed to docker compose. Paths are relative to the repo root.

# Pinned: releases land several times a day.
RADIANCE_IMAGE=stilldeadcode/radiance:1.2.3

# Active model: rad/profiles/<name>.env (file, repo, model flags). Change with ./switch.sh.
RADIANCE_PROFILE=flashnext

# One id for every profile, so clients need no change on a switch; logs/rad.log dates each start.
# Chat/completion requests naming another model are served too; GET /v1/models/<id> is not.
SERVED_MODEL_NAME=qwen-local

RADIANCE_MODELS=models/rad
# Prefix cache disk tier (conversation KV, unencrypted), one directory per profile.
RADIANCE_STATE=rad/state

HOST=0.0.0.0
PORT=8080
