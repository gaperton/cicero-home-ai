# rad/config.env — all settings of the radiance stack. Read by run.sh and passed
# to docker compose. Paths are relative to the repo root.

# Pinned: releases land several times a day.
RADIANCE_IMAGE=stilldeadcode/radiance:1.2.3

RADIANCE_MODELS=models/rad
RADIANCE_MODEL=qwen3.8-next-flash-fp8-iq4r-moe.rad
# Prefix cache disk tier (conversation KV, unencrypted).
RADIANCE_STATE=rad/state

# Clients requesting qwen3.8-27b are served too: the engine ignores the model id.
SERVED_MODEL_NAME=qwen3.8-flash-next
HOST=0.0.0.0
PORT=8080

# Pinned host tier for experts, per card.
HOST_POOL_MIB=12288
