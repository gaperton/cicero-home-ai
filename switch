#!/usr/bin/env bash
# switch — point a GPU's router at a preset and restart just that instance.
#
#   ./switch gpu-1 qwen      # Hindsight memory model
#   ./switch gpu-0 default
#   ./switch gpu-0           # reload the preset already active (after editing it)
#   ./switch                 # show what is active on both
#
# A LoCoMo benchmark run walks gpu-1 through three presets, one per phase. The
# card holds one preset at a time, and each role has its own router id, so the
# Hindsight env is correct throughout and never changes:
#   ./switch gpu-1 oss       # 1. ingest + consolidate  [llm] + [reranker]
#   ./switch gpu-1 answers   # 2. recall + answers      [answer] + [reranker]
#   ./switch gpu-1 judge     # 3. scoring               [judge] + [reranker]
#
# gpu-N/active.ini is a symlink to the chosen preset; that GPU's run.sh reads it.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PRESET_DIR="$SCRIPT_DIR"
CONF_DIR="$HOME/.config/hindsight"
ACTIVE_ENV="$CONF_DIR/hindsight.env"

die() { echo "error: $*" >&2; exit 1; }

# gpu-N -> the systemd unit that serves it
unit_of() { echo "cicero-vulkan${1#gpu-}.service"; }

# Hindsight resolves its LLM through whatever preset gpu-1 is serving, so the env
# file has to move with it. Preset name -> env file; anything unlisted keeps the
# current env.
#
# The benchmark presets (answers, judge) are deliberately unlisted. They serve
# [answer]/[judge] rather than [llm], so no env var changes meaning when they
# load, and Hindsight must NOT be restarted mid-run — a restart here would drop
# the pg0 bench instance's connections between phases.
env_for() {
    case "$1" in
        oss)   echo "hindsight-gpt-oss.env" ;;
        gemma) echo "hindsight-gemma.env" ;;
        qwen)  echo "hindsight-qwen.env" ;;
        *)     echo "" ;;
    esac
}

list_presets() {  # $1 = gpu-N
    find "$PRESET_DIR/$1" -maxdepth 1 -name '*.ini' ! -name 'active.ini' -printf '%f\n' \
        | sed 's/\.ini$//' | sort | tr '\n' ' '
}

show_status() {
    for gpu in gpu-0 gpu-1; do
        local link="$PRESET_DIR/$gpu/active.ini"
        printf '%-6s -> %-16s (%s)\n' "$gpu" \
            "$([ -L "$link" ] && basename "$(readlink -f "$link")" || echo '(unset)')" \
            "$(unit_of "$gpu"): $(systemctl --user is-active "$(unit_of "$gpu")" 2>/dev/null)"
        echo "       available: $(list_presets "$gpu")"
    done
    echo "hindsight.env -> $([ -L "$ACTIVE_ENV" ] && basename "$(readlink -f "$ACTIVE_ENV")" || echo '(plain file)')"
    for port in 8080 8081; do
        echo "  :$port"
        curl -s --max-time 3 "http://127.0.0.1:$port/v1/models" 2>/dev/null | python3 -c '
import json,sys
try:
    for m in json.load(sys.stdin)["data"]: print("    %-16s %s" % (m["id"], m["status"]["value"]))
except Exception: print("    (not reachable)")' 2>/dev/null || echo "    (not reachable)"
    done
}

[[ $# -eq 0 || "${1:-}" == "status" ]] && { show_status; exit 0; }
[[ $# -eq 1 || $# -eq 2 ]] || die "usage: $(basename "$0") {gpu-0|gpu-1} [preset] | status"

gpu="$1"; name="${2:-}"
[[ "$gpu" == gpu-0 || "$gpu" == gpu-1 ]] || die "unknown gpu: $gpu (expected gpu-0 or gpu-1)"
[[ -d "$PRESET_DIR/$gpu" ]] || die "missing preset dir: $PRESET_DIR/$gpu"

# No preset named: reload whatever active.ini already points at. Used after
# editing a live preset — the symlink and the Hindsight env stay untouched,
# only the service restarts.
if [[ -z "$name" ]]; then
    link="$PRESET_DIR/$gpu/active.ini"
    [[ -L "$link" ]] || die "$gpu has no active preset (have: $(list_presets "$gpu"))"
    preset="$(basename "$(readlink -f "$link")")"
    [[ -f "$PRESET_DIR/$gpu/$preset" ]] || die "$gpu/active.ini is dangling -> $preset"
    echo "$gpu -> $preset (unchanged, reloading)"
else
    preset="$name.ini"
    [[ -f "$PRESET_DIR/$gpu/$preset" ]] || die "no preset '$name' in $gpu (have: $(list_presets "$gpu"))"
    ln -sfn "$preset" "$PRESET_DIR/$gpu/active.ini"
    echo "$gpu -> $preset"
fi

envfile=""
if [[ "$gpu" == gpu-1 && -n "$name" ]]; then
    envfile="$(env_for "$name")"
    if [[ -n "$envfile" ]]; then
        [[ -f "$CONF_DIR/$envfile" ]] || die "missing hindsight profile: $CONF_DIR/$envfile"
        [[ -f "$ACTIVE_ENV" && ! -L "$ACTIVE_ENV" ]] && cp -n "$ACTIVE_ENV" "$ACTIVE_ENV.pre-switch.bak"
        ln -sfn "$CONF_DIR/$envfile" "$ACTIVE_ENV"
        echo "hindsight.env -> $envfile"
    fi
fi

unit="$(unit_of "$gpu")"
echo "restarting $unit ..."
systemctl --user restart "$unit"

# Wait for the router to answer, plus any load-on-startup models the preset
# declares. A preset with none must not require 'loaded' or this would hang.
port=$([[ "$gpu" == gpu-0 ]] && echo 8080 || echo 8081)
expect="$(awk '/^\[/{s=substr($0,2,length($0)-2)} /^load-on-startup/{print s}' "$PRESET_DIR/$gpu/$preset" | tr '\n' ' ')"
until curl -s --max-time 3 "http://127.0.0.1:$port/v1/models" 2>/dev/null | python3 -c "
import json,sys
d={m['id']:m['status']['value'] for m in json.load(sys.stdin)['data']}
want='''$expect'''.split()
sys.exit(0 if all(d.get(w)=='loaded' for w in want) else 1)
" 2>/dev/null; do sleep 3; done
echo "  :$port ready${expect:+ (loaded: $expect)}"

# gpu-0 also carries Open WebUI, which takes noticeably longer than the router.
if [[ "$gpu" == gpu-0 ]]; then
    until [[ "$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 http://127.0.0.1:3000/ 2>/dev/null)" == 200 ]]; do sleep 3; done
    echo "  :3000 ready (open-webui)"
fi

if [[ "$gpu" == gpu-1 && -n "$envfile" ]]; then
    echo "restarting hindsight ..."
    systemctl --user restart hindsight.service
    until curl -s -o /dev/null -w '%{http_code}' http://127.0.0.1:8888/health 2>/dev/null | grep -q 200; do sleep 3; done
fi

echo
show_status
