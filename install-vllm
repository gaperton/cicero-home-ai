#!/usr/bin/env bash
set -euo pipefail

reexec_with_login_group_if_needed() {
  local expected_gid current_gid group_name argv_q
  expected_gid="$(getent passwd "${USER:-$(id -un)}" | cut -d: -f4)"
  current_gid="$(id -g)"
  if [ -n "$expected_gid" ] && [ "$current_gid" != "$expected_gid" ] && [ "${VLLM_LOGIN_GROUP_FIXED:-0}" != "1" ]; then
    group_name="$(getent group "$expected_gid" | cut -d: -f1)"
    printf -v argv_q '%q ' "$0" "$@"
    echo "Switching primary group to '$group_name' for rootless Podman..."
    exec sg "$group_name" -c "VLLM_LOGIN_GROUP_FIXED=1 $argv_q"
  fi
}
reexec_with_login_group_if_needed "$@"

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
VLLM_DIR="$SCRIPT_DIR/vllm-rocm"
CHANNEL="${1:-stable}"

if [ ! -d "$VLLM_DIR" ]; then
  echo "ERROR: expected upstream vLLM toolbox repo at: $VLLM_DIR" >&2
  echo "Clone it first:" >&2
  echo "  git clone https://github.com/kyuz0/amd-r9700-vllm-toolboxes.git vllm-rocm" >&2
  exit 1
fi

if ! command -v podman >/dev/null 2>&1; then
  echo "ERROR: Podman is required for this install path." >&2
  exit 1
fi

if ! command -v distrobox >/dev/null 2>&1; then
  echo "distrobox is not installed. Installing via apt..."
  sudo apt-get update
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y distrobox
fi

cd "$VLLM_DIR"

chmod +x refresh-toolbox.sh

echo "Using Podman storage: $(podman info --format '{{.Store.GraphRoot}}')"
echo "Running refresh-toolbox.sh from $VLLM_DIR (channel: $CHANNEL)..."
./refresh-toolbox.sh "$CHANNEL"

echo "Applying local rootless-Podman ROCm fixes inside vllm-r9700..."
podman start vllm-r9700 >/dev/null
podman exec --user root -i vllm-r9700 python - <<'PY'
from pathlib import Path

# In this image, torch preloads packaged librocm_smi64.so.1, which bus-errors
# under Ubuntu rootless Podman. Keep the library discoverable via LD_LIBRARY_PATH
# at runtime, but don't preload it during torch import.
p = Path('/opt/venv/lib64/python3.12/site-packages/torch/_rocm_init.py')
s = p.read_text()
s2 = s.replace(", 'rocm_smi64'", "")
if s2 != s:
    p.write_text(s2)

# AITER JIT module import currently fails under this rootless Podman setup.
# The launcher defaults to TRITON_ATTN, so hide AITER to avoid vLLM model
# inspection importing/building it before startup.
aiter = Path('/opt/venv/lib64/python3.12/site-packages/aiter')
disabled = Path('/opt/venv/lib64/python3.12/site-packages/aiter.disabled')
if aiter.exists() and not disabled.exists():
    import shutil
    try:
        aiter.rename(disabled)
    except OSError:
        shutil.copytree(aiter, disabled)
        shutil.rmtree(aiter)
print('local fixes applied')
PY

echo
echo "Install complete. Run:"
echo "  ./run-vllm"
