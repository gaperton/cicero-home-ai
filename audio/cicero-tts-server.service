[Unit]
Description=Cicero TTS server (qwentts.cpp, Qwen3-TTS 1.7B CustomVoice, Q8_0, Vulkan)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/cicero-home-ai/audio
Environment=TTS_SERVER_PORT=8078
ExecStart=%h/cicero-home-ai/audio/tts-server.sh
Restart=always
RestartSec=10
KillMode=control-group
StandardOutput=append:%h/cicero-home-ai/logs/tts-server.log
StandardError=append:%h/cicero-home-ai/logs/tts-server.log

[Install]
WantedBy=default.target
