version = 1

; Router preset for instance 1 (Vulkan1, port 8081).
; The device and port are assigned by run.sh, so presets target one card at a
; time and must not use split-mode.
[*]
cont-batching = true
flash-attn = true
jinja = true
no-mmap = true
fit = true
fit-target = 256
cache-ram = -1
; f16, not q8_0: llama.cpp's gpt-oss guide advises against quantized KV for this
; model, and it is measurably worse here — prefill 3073 tok/s at q8_0 vs 3962
; tok/s at f16 (+29%) on a 22k-token prompt, decode unchanged at ~133 tok/s.
; Costs VRAM but fits: 19.05 GiB of 31.86 GiB with both models resident.
cache-type-k = f16
cache-type-v = f16

; --- GPT-OSS 20B UD-Q8_K_XL — PRIMARY Hindsight model (Hindsight's own official
; local recommendation). Output is bounded natively via reasoning_effort=low,
; which Hindsight sends in HINDSIGHT_API_LLM_EXTRA_BODY — that env var and this
; preset are a pair, so keep both or neither. enable_thinking is a Gemma/Qwen
; flag and is a no-op here. A 2026-08-06 attempt to replace this with
; gemma4-26b-a4b-qat was reverted; see that preset's banner below for why.
; temp = 0.2 is deliberate and is the ONLY working control for Reflect and
; Consolidation. Verified by proxy capture: of Hindsight's three configured
; temperatures only Retain actually sends one (0.1); Reflect and Consolidation
; send no sampling at all, so without this they inherit llama.cpp's default 0.8
; — far from the 0.0 that ..._TEMPERATURE_CONSOLIDATION asks for, which let the
; same memories consolidate differently run to run. Those two env vars are inert.
; 0.2 rather than 0.0: greedy decoding is the classic repetition-loop trigger on
; this model. Measured to have no effect on tool-call validity (40/40 at llama.cpp
; defaults, at 0.2, and at gpt-oss's official 1.0/1.0/100). Retain still overrides
; this with its own 0.1. top-p/top-k/min-p left at llama.cpp defaults — gpt-oss's
; official 1.0/1.0/0 measured no better. See HINDSIGHT.md.
; ctx-size 300000 / parallel 3 = 100000 per slot; gpt-oss trains at 131072.
; batch/ubatch are raised above llama.cpp's 2048/512 defaults because Hindsight is
; prefill-dominated: measured Retain/Consolidation calls evaluate 22000-24000
; prompt tokens and generate only 25-250, so ~90% of each call is prompt
; processing at ~2500 tok/s. ---
; kv-unified is deliberately NOT set here, unlike the reranker. Measured worse:
; 3-concurrent wall 19.88s median at kv_unified=false vs 21.18s at true (4 reps
; each), with sequential prefill/decode identical. The reranker gains from a
; shared buffer because it processes many short sequences; gpt-oss runs a few
; long causal ones that contend for it instead. Setting it would also raise
; n_ctx_slot to the full 131072, which is useless here — the largest observed
; Hindsight prompt is ~24k tokens.
[gpt-oss-20b]
load-on-startup = true
n-gpu-layers = 99
model = models/GPT-OSS-20B/gpt-oss-20b-UD-Q8_K_XL.gguf
parallel = 3
ctx-size = 300000
temp = 0.2
repeat-penalty = 1.0
batch-size = 4096
ubatch-size = 2048
; Model's own harmony template plus one added line, emitted only when tools are
; present, forcing tool calls onto the commentary channel. Without it gpt-oss
; emits a malformed hybrid `final`/`commentary to=functions.done` header on
; Reflect's later turns, which llama.cpp's PEG parser rejects with HTTP 500.
; Extracted from the GGUF; re-extract and re-apply after a model update.
; See HINDSIGHT.md.
chat-template-file = templates/gpt-oss-20b-harmony.jinja

; --- Qwen3 Reranker 0.6B, Q8_0 — GPU reranking endpoint for Hindsight, to
; replace the CPU BAAI/bge-reranker-v2-m3 path that dominates Recall latency.
;
; kv-unified shares one KV buffer across sequences instead of splitting ctx-size
; into per-slot slices. Measured -29% on a 100-document rerank of real hermes
; text (31.3 -> 22.0 ms/doc). It also removes the per-slot cliff: n_ctx_slot is
; now the full 32768 rather than ctx-size/parallel, so the old failure mode where
; ctx-size 8192 / parallel 8 silently gave 1024 tokens per pair cannot recur.
;
; The ceiling on a single query+document pair is now ubatch-size, not slot ctx.
; Verified live: a ~3100-token pair passes, ~5175 fails with "input is too large
; to process, increase the physical batch size" — and it fails the WHOLE request,
; so HINDSIGHT_API_RERANKER_LITELLM_MAX_TOKENS_PER_DOC=3072 must stay below this.
;
; parallel is NOT a throughput lever: Hindsight sends all candidates in one
; request and llama.cpp processes them serially, so 8 and 32 slots measured
; identically (22.0 vs 21.7 ms/doc). 8 is kept only to serve concurrent Recalls.
; batch/ubatch 4096 measured identical to 8192, so the smaller buffers are free.
; Cost is dominated by document length, not count (14 tok -> 14 ms/doc, 560 tok
; -> 442 ms/doc), but real memories average ~80 tokens so truncating below 3072
; buys nothing: capping at 256 changed latency 3% and rankings not at all. ---
[qwen3-reranker-0.6b]
load-on-startup = true
n-gpu-layers = 99
model = models/Qwen3-Reranker-0.6B/qwen3-reranker-0.6b-q8_0.gguf
reranking = true
; No slot prompt cache: every rerank document is a distinct sequence, so the
; cache never hits and only churns. Inheriting [*]'s cache-ram = -1 (unlimited)
; produced 331 "cache token limit reached, removing oldest entry" warnings in a
; single benchmark run, evicting 15-24 MiB entries continuously.
cache-ram = 0
kv-unified = true
parallel = 8
ctx-size = 32768
batch-size = 4096
ubatch-size = 4096

; --- On-demand alternates for GPU1. NOT resident by default (no
; load-on-startup): they stay unloaded until requested. --models-max is 2
; here and gpt-oss-20b + qwen3-reranker-0.6b already occupy both startup
; slots, so loading any one of these evicts one of the two Hindsight models
; for as long as it stays loaded, and Hindsight (Reflect/Consolidation/Recall)
; degrades until you switch back. Use only when Hindsight isn't actively
; needed. Quant choices mirror models-0.ini's equivalents where one exists. ---

; --- Gemma 4 26B-A4B MoE QAT, UD-Q4_K_XL — ON-DEMAND ONLY. Do NOT make this the
; Hindsight LLM: Reflect never terminates on a real bank. Re-tested 2026-08-06
; against the 1749-memory `psychology` bank and it failed three times, each time
; decoding past 28000-47000 tokens with no EOS until the 300s client timeout,
; leaving the llama.cpp slot wedged afterwards (2 of 3 slots lost in one run).
;
; Root cause is the MODEL, not llama.cpp, and there is no preset that fixes it.
; google-deepmind/gemma#622 reports token-repetition collapse in both gemma-4-31B
; dense and this 26B-A4B MoE, reproducing on Ollama, LMStudio, vLLM and Cloudflare
; alike; gemma3-27b is unaffected on the same stacks. It surfaces most reliably
; under GRAMMAR-CONSTRAINED decoding and 1000+ token generations: the grammar
; keeps EOS out of the allowed token set, so the model's mild repetition bias
; becomes an inescapable loop (vllm#40080). Hindsight's Reflect is exactly that
; shape — tool calls, so llama.cpp always applies a tool-call grammar. Upstream
; llama.cpp#21375 is closed 'not planned'; #25072 and #21799 are open, unfixed.
;
; Mitigations tested here, all FAILED (each a single-variable A/B on psychology):
;   reasoning = off              — fixes Retain/Consolidation overgeneration only
;   temp 0.2 (was 1.0)           — runaway identical, 28699 tokens
;   LLM_STRICT_SCHEMA=false      — no effect; tool calls are grammar-constrained
;                                  regardless of response_format
;   DRY sampler (0.8/1.75/2/8192) — no effect; 27731 tokens, same as without
; Upstream also reports repeat-penalty 1.0-1.5 has no effect, so the repo's
; repeat-penalty = 1.0 convention is not what is costing us here.
;
; And no schema or template change can help, which is worth knowing before
; anyone tries: chat.cpp's gemma4 tool grammar does NOT use the caller's tool
; `parameters` schema at all — the line reading it is commented out behind a TODO
; (common/chat.cpp, `p.tool_args(p.ref("gemma4-dict"))`). Arguments are matched by
; a generic dict whose strings are `until("<|\"|>")` and whose keys are
; `chars("[^:}]", 1, -1)`, both unbounded. So maxLength/minLength — which
; json-schema-to-grammar DOES support — never reach this path, and the Jinja
; template cannot alter a grammar built in C++. Only a llama.cpp patch would.
;
; It IS fine on small banks — a 3-item disposable bank passed Retain/Recall/
; Reflect/Consolidate cleanly (reflect 2.4s avg, 55 output tokens max), because
; generation never gets long enough to collapse. That is why the earlier
; gemma-test-* runs looked healthy and why this had to be caught on `psychology`.
;
; The MTP draft is disabled, not merely unused: loading it fails with
; "Gemma4Assistant requires ctx_other to be set", and llama.cpp then logs
; "[spec] failed to measure draft model memory" and runs without a draft.
[gemma4-26b-a4b-qat]
n-gpu-layers = 99
model = models/Gemma4-26B-A4B-QAT/gemma-4-26B-A4B-it-qat-UD-Q4_K_XL.gguf
;model-draft = models/Gemma4-26B-A4B-QAT/mtp-gemma-4-26B-A4B-it.gguf
;spec-type = draft-mtp
;spec-draft-n-max = 2
; Thinking off. The template defaults enable_thinking to false, but llama.cpp's
; --reasoning defaults to 'auto', which turns it ON when the template supports
; it — verified live: a 40-token probe came back with content "" and the whole
; budget spent in reasoning_content. Hindsight sends no enable_thinking, so
; without this the model reasons on every Retain and Consolidation call.
reasoning = off
; temp 0.2, NOT Gemma's official 1.0. Reflect and Consolidation send no sampling
; params of their own (only Retain sends 0.1), so they inherit whatever is set
; here, and 0.2 is the better default for structured output on this model. It
; does NOT stop the runaway above — that was A/B'd and made no difference — so
; do not read this setting as a fix.
temp = 0.2
top-p = 0.95
top-k = 64
min-p = 0.00
presence-penalty = 0
repeat-penalty = 1.0
; DRY was the last stock-config lever and it FAILED too (2026-08-07): 27731
; tokens and still climbing at the 300s timeout, indistinguishable from the runs
; without it. Left here commented out so nobody re-derives it. Rationale it was
; tried on: repeat-penalty
; is useless here (upstream measured 1.0-1.5 as no help) because it penalises
; individual recent tokens; DRY penalises repeated SEQUENCES, which is the actual
; failure shape, and it acts on the tokens the grammar still permits — and
; gemma4-string-content is `until("<|\"|>")`, so nearly everything is permitted.
; dry-penalty-last-n must be an explicit positive window: llama-sampler.cpp does
; `dry_penalty_last_n = max(dry_penalty_last_n, 0)` and then treats 0 as DISABLED,
; so -1 silently turns DRY off rather than meaning "whole context".
;dry-multiplier = 0.8
;dry-base = 1.75
;dry-allowed-length = 2
;dry-penalty-last-n = 8192
parallel = 3
ctx-size = 300000
