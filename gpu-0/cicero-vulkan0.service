[Unit]
Description=Cicero Open WebUI + llama-server Vulkan0:8080
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/gaperton/cicero-home-ai
Environment=PATH=/home/gaperton/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/gaperton/cicero-home-ai/gpu-0/run.sh
Restart=always
RestartSec=10
TimeoutStopSec=30
KillMode=control-group
StandardOutput=append:/home/gaperton/cicero-home-ai/logs/vulkan0.log
StandardError=append:/home/gaperton/cicero-home-ai/logs/vulkan0.log

[Install]
WantedBy=default.target
